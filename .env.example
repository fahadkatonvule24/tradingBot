# Optional: log in without an already-open terminal. Never commit the real .env.
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Server
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Optional: alerts to your phone. Run `tradebot telegram` for a guided setup.
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=123456789

# Optional: alerts to your own WhatsApp through CallMeBot (send only). Run `tradebot whatsapp`.
# The number needs its country code. The key comes from CallMeBot's activation reply.
# Several numbers: comma-separated, each key in the same position as its number.
WHATSAPP_PHONE=+256700123456
WHATSAPP_APIKEY=1234567

# Optional: push alerts through the free ntfy app (send only). `tradebot ntfy` makes the topic.
# Anyone who knows the topic name can read the alerts: never reuse an example.
# NTFY_SERVER=https://ntfy.example.org   # your own server instead of ntfy.sh
# NTFY_TOKEN=tk_...                      # access token for a reserved, protected topic
